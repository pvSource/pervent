<header class="header">
    <a class="header__logo-box" href="{{ path('app_index') }}">
        <img
                class="header__logo-image"
                src="/build/images/logo.svg"
                alt="Pervent"
        >
    </a>
    <div class="header__nav-box">
        <nav class="header__nav">
            <a href="{{ path('app_contest_index') }}">Конкурсы</a>
        </nav>
        <nav class="header__nav">
            <a href="{{ path('app_about') }}">О проекте</a>
        </nav>
    </div>

    <div class="header__settings-box">
        {% if app.user %}
            {{ app.user }}
            <a href="{{ path('app_logout') }}">Выйти</a>
        {% else %}
            <a href="{{ path('app_register') }}">Регистрация</a>
            <a href="{{ path('app_login') }}">Войти</a>
        {% endif %}
    </div>
</header>