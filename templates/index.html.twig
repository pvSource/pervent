{% extends 'base.html.twig' %}

{% block title %}Pervent{% endblock %}

{% block body %}
    {% if main_contest %}
            <div class="main__contests contests">
                <div class="contests__primary">
                    <article class="contests__item contest-item contest-item_primary">
                        <div class="contest-item__image-box">
                            <img src="{{ main_contest.imagePath }}" alt="{{ main_contest.name }}">
                        </div>
                        <div class="contest-item__text-box">
                            <div class="contest-item__name-box">
                                <a href="{{ path('app_contest_show', {'code': main_contest.code}) }}"> {{ main_contest.name }}</a>
                            </div>
                            <div class="contest-item__description-box">
                                <p>{{ main_contest.description }}</p>
                            </div>
                            <div class="contest-item__date-box">
                                <span>{{ main_contest.beginAt ? main_contest.beginAt|date('d.m.Y') : '' }} - {{ main_contest.beginAt ? main_contest.finishAt|date('d.m.Y') : '' }}</span>
                            </div>
                            <div class="contest-item__actions-box">
                                <a href="{{ path('app_contest_work_new', {'contestCode': main_contest.code}) }}" class="contest-item__button">
                                    Принять участие
                                </a>
                            </div>
                        </div>
                    </article>
                </div>
    {% endif %}
    <div class="contests__list contests-list">
    {% for contest in contests %}
                    <article class="contests-list__item contest-item">
                        <div class="contest-item__image-box">
                            <img src="{{ contest.imagePath }}" alt="{{ contest.name }}">
                        </div>
                        <div class="contest-item__text-box">
                            <div class="contest-item__name-box">
                                <a href="{{ path('app_contest_show', {'code': contest.code}) }}"> {{ contest.name }}</a>
                            </div>
                            <div class="contest-item__description-box">
                                <p>{{ contest.description }}</p>
                            </div>
                            <div class="contest-item__date-box">
                                <span>{{ contest.beginAt ? contest.beginAt|date('d.m.Y') : '' }} - {{ contest.beginAt ? contest.finishAt|date('d.m.Y') : '' }}</span>
                            </div>
                            <div class="contest-item__actions-box">
                                <a href="{{ path('app_contest_work_new', {'contestCode': contest.code}) }}" class="contest-item__button">
                                    Принять участие
                                </a>
                            </div>
                        </div>
                    </article>
    {% endfor %}
    </div>
{% endblock %}
