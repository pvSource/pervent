{% extends 'base.html.twig' %}

{% block title %}{{ contest.name }} > {{ work.name }}{% endblock %}
{% block backlink %}<a href="{{ path('app_contest_show', {'slug': contest.slug})}}">{{ contest.name }}</a>{% endblock %}
{% block maintitle %}{{ work.name }}{% endblock %}
{% block body %}
    <section class="main__work-detail work-detail">
        {{ include('contest/_contest_header.html.twig', {'contest': contest}) }}

        <div class="work-detail__work-box">
            {% if (work.author) %}
            <div class="work-detail__author">
                {{ work.author.email }}
            </div>
            {% endif %}
            <div class="work-detail__info">
                <h2 class="work-detail__name">{{ work.name }}</h2>
                <p class="work-detail__description">
                    {{ work.description }}
                </p>
                {% if (work.imagePath) %}
                    <img src="/uploads/images/{{ work.imagePath }}" alt="{{ work.name }}">
                {% endif %}
            </div>

            <div class="work-detail__action-box">
                {% if (app.user == work.author)  %}
                    <a href="{{ path('app_contest_work_edit', {'id': work.id, 'contestSlug': contest.slug}) }}">Редактировать</a>
                {% endif %}
                <button
                        class="btn-like"
                        data-url="{{ path('app_api_v1_contest_work_like_add', {'workId': work.id, 'contestSlug': contest.slug}) }}"
                >❤️ {{ work.likes|length }}
                </button>
            </div>
        </div>
    </section>

{% endblock %}
