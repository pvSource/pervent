{% extends 'base.html.twig' %}

{% block title %}Конкурсы > {{ contest.name }}{% endblock %}
{% block backlink %}<a href="{{ path('app_contest_index')}}">Конкурсы</a>{% endblock %}
{% block maintitle %}{{ contest.name }}{% endblock %}
{% block body %}
    <section class="main__contest-detail contest-detail">

        {{ include('contest/_contest_header.html.twig', {'contest': contest}) }}

        <div class="contest-detail__filters filters filters_work">
            {{ form_start(filterForm, { method: 'get' }) }}
            {{ form_widget(filterForm) }}
            <button type="submit">Поиск</button>
            {{ form_end(filterForm) }}
        </div>

        <div class="contest-detail__work-list work-list">
            {% for work in works %}
                <div class="work-list__work-item work-item">
                    <div class="work-item__image-box">
                        <img src="{{ work.imagePath }}" alt="Работа">
                    </div>
                    <div class="work-item__text">
                        <a class="work-item__name" href="{{ path('app_contest_work_show', {'contestSlug': contest.slug, 'id': work.id}) }}">
                            {{ work.name }}
                        </a>
                        <p class="work-item__description">{{ work.description }}</p>
                    </div>
                </div>
            {% endfor %}
        </div>

    </section>


{% endblock %}
