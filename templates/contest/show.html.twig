{% extends 'base.html.twig' %}

{% block title %}Конкурс > {{ contest.name }}{% endblock %}
{% block backlink %}<a href="{{ path('app_contest_index')}}">Вернуться ко всем конкурсам</a>{% endblock %}
{% block body %}
    <section class="main__contest-detail contest-detail">
        <div class="contest-detail__header">
            <div class="contest-detail__image">
                <img src="{{ contest.imagePath }}" alt="Конкурс">
            </div>
            <div class="contest-detail__info">
                <div class="contest-detail__name-box">
                    <h2>{{ contest.name }}</h2>
                    <span class="contest-detail__code">{{ contest.code }}</span>
                </div>
                <div class="contest-detail__description-box">
                    {{ contest.description }}
                </div>
                <div class="contest-detail__time-box">
                    <p>Дата начала конкурса: {{ contest.beginAt ? contest.beginAt|date('Y-m-d H:i:s') : '' }}</p>
                    <p>Дата окончания конкурса: {{ contest.beginAt ? contest.finishAt|date('Y-m-d H:i:s') : '' }}</p>
                </div>
            </div>

            <div class="contest-detail__action-box">
                <a href="{{ path('app_contest_work_new', {'contestCode': contest.code}) }}">Участвовать</a>
                <a href="{{ path('app_contest_edit', {'code': contest.code}) }}">Редактировать конкурс</a>
                {{ include('contest/_delete_form.html.twig') }}
            </div>
        </div>

        <div class="contest-detail__filters">

        </div>

        <div class="contest-detail__work-list work-list">
            {% for work in works %}
                <div class="work-list__work-item work-item">
                    <div class="work-item__image-box">
                        <img src="{{ work.imagePath }}" alt="Работа">
                    </div>
                    <div class="work-item__text">
                        <a class="work-item__name" href="{{ path('app_contest_work_show', {'contestCode': contest.code, 'id': work.id}) }}">
                            {{ work.name }}
                        </a>
                        <p class="work-item__description">{{ work.description }}</p>
                    </div>
                </div>
            {% endfor %}
        </div>

    </section>


{% endblock %}
