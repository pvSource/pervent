{% extends 'base.html.twig' %}

{% block title %}Contest{% endblock %}

{% block body %}
    <h1>Contest</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ contest.id }}</td>
            </tr>
            <tr>
                <th>Code</th>
                <td>{{ contest.code }}</td>
            </tr>
            <tr>
                <th>Name</th>
                <td>{{ contest.name }}</td>
            </tr>
            <tr>
                <th>Description</th>
                <td>{{ contest.description }}</td>
            </tr>
            <tr>
                <th>BeginAt</th>
                <td>{{ contest.beginAt ? contest.beginAt|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>FinishAt</th>
                <td>{{ contest.finishAt ? contest.finishAt|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
        </tbody>
    </table>

    <h2>Все работы конкурса:</h2>
    {% for work in works %}
        <div style="border: 1px black solid">
            <a href="{{ path('app_contest_work_show', {'contestCode': contest.code, 'id': work.id}) }}">{{ work.name }}</a>
            <p>{{ work.description }}</p>
        </div>
    {% endfor %}


    <a href="{{ path('app_contest_index') }}">back to list</a>

    <a href="{{ path('app_contest_edit', {'code': contest.code}) }}">edit</a>

    {{ include('contest/_delete_form.html.twig') }}
{% endblock %}
