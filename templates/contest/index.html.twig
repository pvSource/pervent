{% extends 'base.html.twig' %}

{% block title %}Конкурсы{% endblock %}
{% block maintitle %}Конкурсы{% endblock %}
{% block chainadditional %}
    <a href="{{ path('app_contest_new') }}"> [ Создать ] </a>
{% endblock %}

{% block body %}
    <div class="contests__filters filters filters_contest">
        {{ form_start(filterForm, { method: 'get' }) }}
            {{ form_widget(filterForm) }}
            <button type="submit">Поиск</button>
        {{ form_end(filterForm) }}
    </div>

    <div class="contests__list contests-list">
        {% for contest in contests %}

            <article class="contests-list__item contest-item">
                <div class="contest-item__image-box">
                    <img src="/uploads/images/{{ contest.imagePath }}" alt="{{ contest.name }}">
                </div>
                <div class="contest-item__text-box">
                    <div class="contest-item__name-box">
                        <h4>{{ contest.name }}</h4>
                    </div>
                    <div class="contest-item__description-box">
                        <p>{{ contest.description }}</p>
                    </div>
                    <div class="contest-item__date-box">
                        <span>{{ contest.beginAt ? contest.beginAt|date('Y-m-d H:i:s') : '' }} - {{ contest.finishAt ? contest.finishAt|date('Y-m-d H:i:s') : '' }}</span>
                    </div>
                    <div class="contest-item__actions-box">
                        {% if app.user %}

                        <a href="{{ path('app_contest_work_new', {'contestSlug': contest.slug}) }}" class="contest-item__button">
                            Принять участие
                        </a>

                            {% if app.user == contest.author %}
                                <a href="{{ path('app_contest_edit', {'slug': contest.slug}) }}" class="contest-item__button">
                                    Редактировать
                                </a>
                            {% endif %}
                        {% endif %}


                        <a href="{{ path('app_contest_show', {'slug': contest.slug}) }}" class="contest-item__button">
                            Показать
                        </a>

                    </div>
                </div>
            </article>
        {% else %}
            <p>
                Не найдено конкурсов!
            </p>
        {% endfor %}
    </div>
    {% if previous >= 0 %}
        <a href="{{ path('app_contest_index', {'offset': previous}) }}">Преддыдущая страница</a>
    {% endif %}

    {% if next < contests|length  %}
        <a href="{{ path('app_contest_index', {'offset': next}) }}">Следующая страница</a>
    {% endif %}

{% endblock %}
